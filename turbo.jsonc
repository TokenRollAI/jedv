{
	"$schema": "https://turbo.build/schema.json",
	"ui": "tui",
	"globalEnv": [
		"DESKTOP_DISPLAY_NAME",
		"DESKTOP_VITE_PORT",
		"DESKTOP_NOTIFICATIONS_PORT",
		"JEDV_WORKSPACE_NAME"
	],
	"globalPassThroughEnv": [
		"NODE_ENV",
		"CI",
		"npm_lifecycle_event",
		"RENDERER_REMOTE_DEBUG_PORT",
		"JEDV_WORKSPACE_ID",
		"JEDV_PTY_DAEMON_ADOPT_IN_DEV",
		"JEDV_HOST_WORKER_SCRIPT_PATH",
		"JEDV_CHAT_V3_MIGRATIONS",
		"JEDV_CHAT_V3_CLAUDE_BIN"
	],
	"tasks": {
		"build": {
			"inputs": ["$TURBO_DEFAULT$", ".env*"],
			"dependsOn": ["^build"],
			"outputs": [
				"dist/**",
				"dist-electron/**",
				"release/**",
				".cache/tsbuildinfo.json"
			]
		},
		"dev": {
			// Compiled Lingui catalogs are generated, not committed, so dev has to
			// build them before anything imports @jedv/i18n. Scoped to that one
			// package so starting dev doesn't drag in every other build.
			"dependsOn": ["@jedv/i18n#build"],
			// launchd gives the GUI session its ssh-agent socket; without it, ssh
			// in dev-app terminals cannot use agent keys.
			"passThroughEnv": ["SSH_AUTH_SOCK"],
			"cache": false,
			"persistent": true
		},
		"test": {
			"dependsOn": ["^build"],
			"outputs": ["coverage/**"]
		},
		"test:integration:terminal": {
			"dependsOn": ["^build"],
			"cache": false
		},
		"build:types": {
			// Emits declarations from source, so it needs the same upstream
			// generated inputs a build does — the compiled Lingui catalogs in
			// particular, which host-service reaches through @jedv/i18n.
			"dependsOn": ["^build", "^build:types"],
			"outputs": ["dist-types/**"]
		},
		"typecheck": {
			"dependsOn": ["^build", "^build:types"],
			"outputs": [".cache/tsbuildinfo.json"]
		},
		"lint": {
			"outputs": []
		},
		"clean": {
			"cache": false
		},
		"ui-add": {
			"cache": false,
			"interactive": true
		}
	}
}
