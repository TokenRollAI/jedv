msgid "This shortcut will be assigned to {0}. These actions will become unassigned: {1}."
msgstr "Pintasan ini akan ditetapkan ke {0}. Tindakan berikut akan menjadi tidak ditetapkan: {1}."

#. placeholder {0}: killing?.title
msgid "This stops {0} and its child processes. Unsaved work in the terminal can be lost."
msgstr "Ini menghentikan {0} dan proses turunannya. Pekerjaan yang belum disimpan di terminal dapat hilang."

msgid "This stops all worker terminals and automatic wake-ups. The leader terminal remains open."
msgstr "Ini menghentikan semua terminal worker dan pemanggilan otomatis. Terminal pemimpin tetap terbuka."

msgid "This stops only the listed forwarding tunnels. Processes on the target host keep running."
msgstr "Ini hanya menghentikan tunnel penerusan yang tercantum. Proses di host tujuan tetap berjalan."

msgid "This stops the listed processes on the original host. Terminal work or servers using them can be interrupted. Forwarding tunnels are separate."
msgstr "Ini menghentikan proses yang tercantum di host asal. Pekerjaan terminal atau server yang menggunakannya dapat terganggu. Tunnel penerusan terpisah."

msgid "This stops the local process occupying the forwarded port."
msgstr "Ini menghentikan proses lokal yang menggunakan port yang diteruskan."

msgid "This stops the process listening on this port."
msgstr "Ini menghentikan proses yang mendengarkan di port ini."

msgid "This stops the processes listening on the listed workspace ports."
msgstr "Ini menghentikan proses yang mendengarkan di port ruang kerja yang tercantum."

msgid "This stops the shell and all processes running in this terminal. Workspace files are kept. Unsaved process state may be lost."
msgstr "Ini menghentikan shell dan semua proses di terminal ini. File workspace tetap dipertahankan. Status proses yang belum disimpan dapat hilang."

msgid "This stops the worker terminal and may interrupt its work."
msgstr "Ini menghentikan terminal worker dan dapat mengganggu pekerjaannya."

msgid "This terminal has exited. Refresh the team to see its current status."
msgstr "Terminal ini telah berakhir. Segarkan tim untuk melihat status terkini."

msgid "This terminal is also open on a smaller screen, so it's sized to fit"
msgstr "Terminal ini juga terbuka di layar yang lebih kecil, jadi ukurannya disesuaikan"

msgid "This terminal is no longer running. Refresh the session list."
msgstr "Terminal ini tidak lagi berjalan. Segarkan daftar sesi."

msgid "This thread has no comment to reply to, or GitHub authentication is unavailable."
msgstr "Thread ini tidak memiliki komentar untuk dibalas, atau autentikasi GitHub tidak tersedia."

msgid "This thread has no comment to reply to."
msgstr "Thread ini tidak punya komentar untuk dibalas."

msgid "This updates the remote base branch on GitHub."
msgstr "Ini memperbarui branch dasar remote di GitHub."

msgid "This updates the review thread on GitHub."
msgstr "Ini memperbarui thread review di GitHub."

msgid "This view hit an error"
msgstr "Tampilan ini mengalami kesalahan"

msgid "This workspace cannot be deleted in its current state."
msgstr "Ruang kerja ini tidak dapat dihapus dalam keadaan saat ini."

msgid "This workspace shares the project's files, index, and current branch. It does not switch branches or run setup."
msgstr "Ruang kerja ini berbagi file, indeks, dan cabang proyek saat ini. Tidak berpindah cabang atau menjalankan konfigurasi."

msgid "This writes .jedv/memory.json on the target host and replaces the existing file."
msgstr "Ini menulis .jedv/memory.json pada host tujuan dan mengganti berkas yang ada."

