msgid "This stops {0} and its child processes. Unsaved work in the terminal can be lost."
msgstr "Tímto se zastaví proces {0} a jeho podřízené procesy. Neuložená práce v terminálu může být ztracena."

msgid "This stops all worker terminals and automatic wake-ups. The leader terminal remains open."
msgstr "Tím se zastaví všechny terminály workerů a automatická probouzení. Terminál vedoucího zůstane otevřený."

msgid "This stops only the listed forwarding tunnels. Processes on the target host keep running."
msgstr "Tímto se zastaví pouze uvedené tunely přesměrování. Procesy na cílovém hostiteli budou pokračovat."

msgid "This stops the listed processes on the original host. Terminal work or servers using them can be interrupted. Forwarding tunnels are separate."
msgstr "Tímto se zastaví uvedené procesy na původním hostiteli. Práce v terminálu nebo servery, které je používají, mohou být přerušeny. Tunely přesměrování jsou oddělené."

msgid "This stops the local process occupying the forwarded port."
msgstr "Tímto se zastaví místní proces obsazující přesměrovaný port."

msgid "This stops the process listening on this port."
msgstr "Tímto se zastaví proces naslouchající na tomto portu."

msgid "This stops the processes listening on the listed workspace ports."
msgstr "Tímto se zastaví procesy naslouchající na uvedených portech pracovního prostoru."

msgid "This stops the shell and all processes running in this terminal. Workspace files are kept. Unsaved process state may be lost."
msgstr "Tímto se zastaví shell a všechny procesy v tomto terminálu. Soubory pracovního prostoru zůstanou zachovány. Neuložený stav procesů může být ztracen."

msgid "This stops the worker terminal and may interrupt its work."
msgstr "Tím se zastaví terminál workera a může se přerušit jeho práce."

msgid "This terminal has exited. Refresh the team to see its current status."
msgstr "Tento terminál skončil. Obnovte tým a zobrazte aktuální stav."

msgid "This terminal is also open on a smaller screen, so it's sized to fit"
msgstr "Tento terminál je otevřený i na menší obrazovce, proto je přizpůsobený její velikosti"

msgid "This terminal is no longer running. Refresh the session list."
msgstr "Tento terminál již neběží. Obnovte seznam relací."

msgid "This thread has no comment to reply to, or GitHub authentication is unavailable."
msgstr "Toto vlákno nemá žádný komentář, na který by bylo možné odpovědět, nebo ověření GitHubu není dostupné."

msgid "This thread has no comment to reply to."
msgstr "V tomto vlákně není komentář, na který by šlo odpovědět."

msgid "This updates the remote base branch on GitHub."
msgstr "Tím se aktualizuje vzdálená základní větev na GitHubu."

msgid "This updates the review thread on GitHub."
msgstr "Tím se aktualizuje vlákno revize na GitHubu."

msgid "This view hit an error"
msgstr "V tomto zobrazení došlo k chybě"

