msgid "This stops {0} and its child processes. Unsaved work in the terminal can be lost."
msgstr "Thao tác này dừng {0} và các tiến trình con. Công việc chưa lưu trong terminal có thể bị mất."

msgid "This stops only the listed forwarding tunnels. Processes on the target host keep running."
msgstr "Thao tác này chỉ dừng đường hầm chuyển tiếp được liệt kê. Tiến trình trên máy chủ đích vẫn tiếp tục chạy."

msgid "This stops the listed processes on the original host. Terminal work or servers using them can be interrupted. Forwarding tunnels are separate."
msgstr "Thao tác này dừng tiến trình được liệt kê trên máy chủ ban đầu. Công việc terminal hoặc máy chủ sử dụng các tiến trình đó có thể bị gián đoạn. Đường hầm chuyển tiếp là riêng biệt."

msgid "This stops the local process occupying the forwarded port."
msgstr "Thao tác này dừng tiến trình cục bộ đang chiếm cổng được chuyển tiếp."

msgid "This stops the process listening on this port."
msgstr "Thao tác này dừng tiến trình đang lắng nghe trên cổng này."

msgid "This stops the processes listening on the listed workspace ports."
msgstr "Thao tác này dừng tiến trình đang lắng nghe trên các cổng không gian làm việc được liệt kê."

msgid "This stops the shell and all processes running in this terminal. Workspace files are kept. Unsaved process state may be lost."
msgstr "Điều này sẽ dừng shell và tất cả các tiến trình trong terminal. Các tệp workspace được giữ lại. Trạng thái tiến trình chưa lưu có thể bị mất."

msgid "This terminal is also open on a smaller screen, so it's sized to fit"
