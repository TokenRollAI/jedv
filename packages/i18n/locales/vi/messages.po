msgstr "Nhánh đã thay đổi. Hãy xem lại nhánh hiện tại trước khi thử lại."

msgid "The command used to start this agent."
msgstr "Lệnh dùng để khởi động agent này."

msgid "The default location for new worktrees on the connected host."
msgstr "Vị trí mặc định cho worktree mới trên host đã kết nối."

msgid "The definition and its run records will be deleted. Existing workspaces and sessions remain available."
msgstr "Định nghĩa và các bản ghi lượt chạy sẽ bị xóa. Workspace và phiên hiện có vẫn khả dụng."

msgid "The existing session identity could not be verified. Refresh before retrying."
msgstr "Không thể xác minh danh tính phiên hiện có. Hãy làm mới trước khi thử lại."

msgid "The file changed on disk. Review it before saving again."
msgstr "Tệp đã thay đổi trên đĩa. Hãy xem lại trước khi lưu tiếp."

msgid "The file changed. Review its diff before discarding."
msgstr "Tệp đã thay đổi. Hãy xem diff trước khi hủy thay đổi."

msgid "The file did not contain any importable themes."
msgstr "Tệp không chứa theme nào có thể nhập."

msgid "The file path is unavailable"
msgstr "Đường dẫn tệp không khả dụng"

msgid "The Jedv host service for {organization} stopped unexpectedly ({cause}) and could not be restarted automatically."
msgstr "Dịch vụ host Jedv cho {organization} đã dừng bất ngờ ({cause}) và không tự khởi động lại được."

msgid "The Jedv host service stopped unexpectedly ({cause}) and could not be restarted automatically."
msgstr "Dịch vụ host Jedv đã dừng bất ngờ ({cause}) và không tự khởi động lại được."

msgid "The linked local agent is unavailable on this host. Edit the preset or remove its agent link."
msgstr "Tác tử cục bộ được liên kết không khả dụng trên máy chủ này. Hãy chỉnh sửa cấu hình định sẵn hoặc gỡ liên kết tác tử."

msgid "The local host service is unavailable for {organization} on {device}. Status: {status}. {recovery}"
msgstr "Dịch vụ host cục bộ không khả dụng cho {organization} trên {device}. Trạng thái: {status}. {recovery}"

msgid "The operation result is unknown. Check the branch history and remote before retrying."
msgstr "Không rõ kết quả thao tác. Hãy kiểm tra lịch sử nhánh và remote trước khi thử lại."

msgid "The page you're looking for doesn't exist."
msgstr "Trang bạn tìm không tồn tại."

msgid "The project is saved, but its workspace could not be opened. Continue opening to retry without creating another project."
msgstr "Dự án đã được lưu nhưng không thể mở không gian làm việc. Hãy tiếp tục mở để thử lại mà không tạo dự án khác."

msgid "The project was saved. Continue opening its workspace."
msgstr "Dự án đã được lưu. Hãy tiếp tục mở không gian làm việc của dự án."

msgid "The repository directory is missing on this host. Open the repository at its current path to set it up again."
msgstr "Thư mục kho mã không tồn tại trên máy chủ này. Hãy mở kho mã ở đường dẫn hiện tại để thiết lập lại."

msgid "The request ended before its result was confirmed. Check the target host for a completed project or partial directory before trying again."
msgstr "Yêu cầu kết thúc trước khi kết quả được xác nhận. Hãy kiểm tra dự án đã hoàn tất hoặc thư mục một phần trên máy chủ đích trước khi thử lại."

msgid "The resumed session identity could not be verified. Refresh before retrying."
msgstr "Không thể xác minh danh tính phiên được tiếp tục. Hãy làm mới trước khi thử lại."

msgid "The run command is still stopping. Wait, then restart."
msgstr "Lệnh chạy vẫn đang dừng. Hãy đợi rồi khởi động lại."

msgid "The screenshot is no longer available."
msgstr "Ảnh chụp màn hình không còn khả dụng."

msgid "The session changed. Select its current run in the workspace."
msgstr "Phiên đã thay đổi. Chọn lượt chạy hiện tại của phiên trong workspace."

msgid "The session identity changed. Select it again."
msgstr "Danh tính phiên đã thay đổi. Hãy chọn lại."

msgid "The session identity is unavailable."
msgstr "Danh tính phiên không khả dụng."

msgid "The staged files changed. Review them before committing."
msgstr "Tệp đã stage đã thay đổi. Hãy xem lại trước khi commit."

msgid "The symbolic link target is unavailable"
msgstr "Đích của liên kết tượng trưng không khả dụng"

msgid "The target directory is missing, but the operation result is unknown. This does not confirm cancellation. Check the operation status again."
msgstr "Thư mục đích không tồn tại nhưng không rõ kết quả thao tác. Điều này không xác nhận việc hủy. Hãy kiểm tra lại trạng thái thao tác."

msgid "The target host confirmed this operation has ended. You can retry; an existing directory will not be overwritten."
msgstr "Máy chủ đích xác nhận thao tác này đã kết thúc. Bạn có thể thử lại; thư mục hiện có sẽ không bị ghi đè."

msgid "The target host confirmed this operation has stopped. You can retry; if the target directory remains, choose another location."
msgstr "Máy chủ đích xác nhận thao tác này đã dừng. Bạn có thể thử lại; nếu thư mục đích vẫn còn, hãy chọn vị trí khác."

msgid "The target host is still processing this request. Check again before starting another operation here."
msgstr "Máy chủ đích vẫn đang xử lý yêu cầu này. Hãy kiểm tra lại trước khi bắt đầu thao tác khác tại đây."

msgid "The target pane area cannot receive this pane"
msgstr "Vùng ngăn đích không thể nhận ngăn này"

msgid "The target pane area did not receive this pane"
msgstr "Vùng ngăn đích đã không nhận ngăn này"

msgid "The target workspace changed. Return to the original workspace before continuing."
msgstr "Không gian làm việc đích đã thay đổi. Hãy quay lại không gian làm việc ban đầu trước khi tiếp tục."

msgid "The target workspace changed. The result belongs to the original workspace."
msgstr "Không gian làm việc đích đã thay đổi. Kết quả thuộc về không gian làm việc ban đầu."

msgid "The terminal session changed. Refresh before inserting the prompt."
msgstr "Phiên terminal đã thay đổi. Hãy làm mới trước khi chèn prompt."

msgid "The terminal session ended unexpectedly"
msgstr "Phiên terminal kết thúc đột ngột"

msgid "The workspace changed"
msgstr "Không gian làm việc đã thay đổi"

msgid "The workspace files will change to the selected branch."
msgstr "Tệp trong không gian làm việc sẽ chuyển sang nhánh đã chọn."

msgid "The workspace is saved. Continue opening it without creating another workspace."
msgstr "Không gian làm việc đã được lưu. Hãy tiếp tục mở mà không tạo không gian làm việc khác."

msgid "The workspace list changed on the host. Refresh it before reordering."
msgstr "Danh sách không gian làm việc trên máy chủ đã thay đổi. Hãy làm mới trước khi sắp xếp lại."

msgid "The workspace was deleted. Continue to refresh the target host."
msgstr "Không gian làm việc đã bị xóa. Hãy tiếp tục làm mới máy chủ đích."

msgid "Theme"
msgstr "Theme"

msgid "Theme default"
msgstr "Mặc định của theme"

msgid "Theme file too large"
msgstr "Tệp theme quá lớn"

msgid "These metrics belong to this device. Remote host processes are not included."
msgstr "Các chỉ số này thuộc về thiết bị này. Tiến trình máy chủ từ xa không được bao gồm."

msgid "These notes ship with the application. Published release details are available in the Jedv repository."
msgstr "Các ghi chú này được cung cấp cùng ứng dụng. Chi tiết bản phát hành đã công bố có trong kho mã Jedv."

msgid "This action is irreversible."
msgstr "Không thể hoàn tác thao tác này."

msgid "This API login does not expose subscription quota."
msgstr "Thông tin đăng nhập API này không cung cấp hạn mức thuê bao."

msgid "This automation is no longer available"
msgstr "Automation này không còn khả dụng"

msgid "This branch has conflicts"
msgstr "Branch này có xung đột"

msgid "This changes the pull request state on GitHub."
msgstr "Thao tác này thay đổi trạng thái pull request trên GitHub."

msgid "This chat is no longer live. The prompt was not sent."
msgstr "Cuộc trò chuyện này không còn trực tiếp. Prompt chưa được gửi."

msgid "This chat is read only. Use Start new session to begin another chat."
msgstr "Cuộc trò chuyện này ở chế độ chỉ đọc. Hãy dùng Bắt đầu phiên mới để bắt đầu cuộc trò chuyện khác."

msgid "This closes every terminal session on this host, including running agents and background processes. Restart does not preserve sessions."
msgstr "Thao tác này đóng mọi phiên terminal trên máy chủ, bao gồm tác tử đang chạy và tiến trình nền. Khởi động lại không giữ các phiên."

msgid "This closes the run terminal and its running processes."
msgstr "Thao tác này đóng terminal chạy và các tiến trình đang chạy của nó."

msgid "This closes the workspace and its terminals. The project's files, branches and other workspaces stay as they are."
msgstr "Thao tác này đóng workspace và các terminal của nó. Tệp, nhánh và các workspace khác của dự án vẫn giữ nguyên."

msgid "This comment will be visible on the remote pull request."
msgstr "Bình luận này sẽ hiển thị trên pull request remote."

msgid "This creates a remote pull request from the workspace branch."
msgstr "Thao tác này tạo pull request remote từ branch workspace."

msgid "This deletes the file from disk. Unsaved editor buffers are kept. This action cannot be undone."
msgstr "Thao tác này xóa tệp khỏi ổ đĩa. Bộ đệm chưa lưu của trình chỉnh sửa được giữ lại. Không thể hoàn tác thao tác này."

msgid "This deletes the folder and all its contents. Unsaved editor buffers are kept. This action cannot be undone."
msgstr "Thao tác này xóa thư mục và toàn bộ nội dung. Bộ đệm chưa lưu của trình chỉnh sửa được giữ lại. Không thể hoàn tác thao tác này."

msgid "This deletes the session's folder and everything in it from disk."
msgstr "Thao tác này xóa thư mục của phiên và mọi thứ trong đó khỏi đĩa."

msgid "this device"
msgstr "thiết bị này"

msgid "This device"
msgstr "Thiết bị này"

msgid "this device ({id})"
msgstr "thiết bị này ({id})"

msgid "This draft belongs to another session. Return to it or discard the draft before composing here."
msgstr "Bản nháp này thuộc về phiên khác. Hãy quay lại phiên đó hoặc hủy bản nháp trước khi soạn tại đây."

msgid "This file cannot be edited as text."
msgstr "Không thể chỉnh sửa tệp này dưới dạng văn bản."

msgid "This file is outside the workspace"
msgstr "Tệp này nằm ngoài workspace"

msgid "This file is outside the workspace or its symbolic link cannot be safely resolved"
msgstr "Tệp này nằm ngoài không gian làm việc hoặc không thể xử lý an toàn liên kết tượng trưng của tệp"

msgid "This folder is not a Git repository. Initialize Git here and import it as a project? Existing files will be kept."
msgstr "Thư mục này không phải kho Git. Khởi tạo Git tại đây và nhập thành dự án? Tệp hiện có sẽ được giữ lại."

msgid "This host did not provide a readable preview. Review the request in the agent CLI before approving."
msgstr "Máy chủ này không cung cấp bản xem trước có thể đọc được. Hãy xem lại yêu cầu trong CLI tác tử trước khi phê duyệt."

msgid "This is a large file. Opening it may slow down the editor."
msgstr "Đây là tệp lớn. Mở tệp có thể làm trình chỉnh sửa chậm lại."

msgid "This pane can't be shown"
msgstr "Không thể hiển thị ngăn này"

msgid "This pane hit an error"
msgstr "Ngăn này gặp lỗi"

msgid "This permanently deletes the removed project and workspace records and attempts to remove their clean worktree directories. Dirty worktree directories may remain untracked. The main repository directory is kept. This cannot be undone."
msgstr "Thao tác này xóa vĩnh viễn bản ghi dự án và không gian làm việc đã xóa, đồng thời cố gắng xóa thư mục worktree sạch. Thư mục worktree có thay đổi có thể vẫn còn và không được theo dõi. Thư mục kho mã chính được giữ lại. Không thể hoàn tác thao tác này."

msgid "This preview was shortened. Review the full request in the agent CLI."
msgstr "Bản xem trước đã được rút ngắn. Hãy xem toàn bộ yêu cầu trong CLI tác tử."

msgid "This project cannot be removed in its current state."
msgstr "Không thể xóa dự án này ở trạng thái hiện tại."

msgid "This project is not set up on the target host."
msgstr "Dự án này chưa được thiết lập trên máy chủ đích."

msgid "This project still uses the older config.json. It keeps working; convert it to config.toml to use the new sections."
msgstr "Dự án này vẫn dùng config.json cũ. Nó vẫn hoạt động; hãy chuyển sang config.toml để dùng các phần mới."

msgid "This project's host is offline"
msgstr "Host của dự án này đang ngoại tuyến"

msgid "This prompt is no longer active."
msgstr "Prompt này không còn hoạt động."

msgid "This removes all custom shortcut bindings, including actions outside this list."
msgstr "Thao tác này xóa mọi gán phím tắt tùy chỉnh, kể cả thao tác ngoài danh sách này."

msgid "This removes all saved screenshots listed here. Attachments already copied into a workspace are kept."
msgstr "Thao tác này xóa tất cả ảnh chụp màn hình đã lưu được liệt kê tại đây. Tệp đính kèm đã sao chép vào không gian làm việc được giữ lại."

msgid "This removes custom agents and replaces all launch configurations with the four bundled defaults. Existing sessions keep running. This cannot be undone."
msgstr "Thao tác này xóa tác tử tùy chỉnh và thay tất cả cấu hình khởi chạy bằng bốn cấu hình mặc định đi kèm. Phiên hiện có vẫn tiếp tục chạy. Không thể hoàn tác thao tác này."

msgid "This removes its launch configuration. Existing sessions keep running."
msgstr "Thao tác này xóa cấu hình khởi chạy. Các phiên hiện có vẫn tiếp tục chạy."

msgid "This removes the saved commands from this device. Running terminals are not affected."
msgstr "Thao tác này xóa lệnh đã lưu khỏi thiết bị này. Terminal đang chạy không bị ảnh hưởng."

msgid "This removes the worktree from disk and closes the workspace."
msgstr "Thao tác này xóa worktree khỏi ổ đĩa và đóng workspace."

msgid "This reply will be visible in the remote review thread."
msgstr "Phản hồi này sẽ hiển thị trong luồng review remote."

msgid "This repository is no longer available as a Git repository."
msgstr "Kho mã này không còn tồn tại dưới dạng kho Git."

