msgstr "Le chemin du fichier n’est pas disponible"

msgid "The Jedv host service for {organization} stopped unexpectedly ({cause}) and could not be restarted automatically."
msgstr "Le service hôte Jedv pour {organization} s'est arrêté de façon inattendue ({cause}) et n'a pas pu être redémarré automatiquement."

msgid "The Jedv host service stopped unexpectedly ({cause}) and could not be restarted automatically."
msgstr "Le service hôte Jedv s'est arrêté de façon inattendue ({cause}) et n'a pas pu être redémarré automatiquement."

msgid "The linked local agent is unavailable on this host. Edit the preset or remove its agent link."
msgstr "L’agent local lié n’est pas disponible sur cet hôte. Modifiez le préréglage ou supprimez son lien d’agent."

msgid "The local host service is unavailable for {organization} on {device}. Status: {status}. {recovery}"
msgstr "Le service hôte local est indisponible pour {organization} sur {device}. Statut : {status}. {recovery}"

