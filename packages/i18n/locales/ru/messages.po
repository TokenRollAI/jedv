msgstr "Каталог репозитория отсутствует на этом хосте. Откройте репозиторий по его текущему пути, чтобы настроить его снова."

msgid "The request ended before its result was confirmed. Check the target host for a completed project or partial directory before trying again."
msgstr "Запрос завершился до подтверждения результата. Проверьте на целевом хосте наличие завершённого проекта или частичного каталога перед повторной попыткой."

msgid "The requested run is not in the loaded history."
msgstr "Этого запуска нет в загруженной истории."

msgid "The result is uncertain. Refresh before deciding again."
msgstr "Результат неопределён. Обновите перед повторным решением."

msgid "The result is uncertain. Retry this message with the same request ID."
msgstr "Результат неопределён. Повторите сообщение с тем же ID запроса."

msgid "The resumed session identity could not be verified. Refresh before retrying."
msgstr "Не удалось проверить идентичность возобновлённого сеанса. Обновите перед повторной попыткой."

msgid "The resumed terminal is not available yet. Refresh the workspace to retry."
msgstr "Возобновлённый терминал пока недоступен. Обновите рабочую область и повторите попытку."

