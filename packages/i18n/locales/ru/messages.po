msgstr "Этот терминал недоступен в текущей рабочей области."

msgid "The terminal session changed. Refresh before inserting the prompt."
msgstr "Сеанс терминала изменился. Обновите перед вставкой запроса."

msgid "The terminal session ended unexpectedly"
msgstr "Сеанс терминала неожиданно завершился"

msgid "The workspace changed"
msgstr "Рабочая область изменилась"

