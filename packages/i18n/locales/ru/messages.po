msgid "This closes the workspace and its terminals. The project's files, branches and other workspaces stay as they are."
msgstr "Рабочая область и её терминалы будут закрыты. Файлы, ветки и другие рабочие области проекта останутся без изменений."

msgid "This comment will be visible on the remote pull request."
msgstr "Этот комментарий будет виден в удалённом пул-реквесте."

msgid "This creates a remote pull request from the workspace branch."
msgstr "Это создаст удалённый пул-реквест из ветки рабочей области."

msgid "This deletes the file from disk. Unsaved editor buffers are kept. This action cannot be undone."
msgstr "Это удалит файл с диска. Несохранённые буферы редактора сохраняются. Это действие нельзя отменить."

msgid "This deletes the folder and all its contents. Unsaved editor buffers are kept. This action cannot be undone."
msgstr "Это удалит папку и всё её содержимое. Несохранённые буферы редактора сохраняются. Это действие нельзя отменить."

msgid "This deletes the session's folder and everything in it from disk."
msgstr "Это удалит папку сессии и всё её содержимое с диска."

msgid "this device"
msgstr "это устройство"

msgid "This device"
msgstr "Это устройство"

msgid "this device ({id})"
msgstr "это устройство ({id})"

msgid "This device will need to pair again."
msgstr "Это устройство потребуется сопрячь заново."

msgid "This draft belongs to another session. Return to it or discard the draft before composing here."
msgstr "Этот черновик принадлежит другому сеансу. Вернитесь к нему или отмените черновик, прежде чем писать здесь."

