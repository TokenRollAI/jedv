msgid "This folder is not a Git repository. Initialize Git here and import it as a project? Existing files will be kept."
msgstr "Эта папка не является репозиторием Git. Инициализировать Git здесь и импортировать её как проект? Существующие файлы будут сохранены."

msgid "This host"
msgstr "Этот хост"

msgid "This host cannot start team tasks. Update the host or use an existing session."
msgstr "Этот хост не может запускать задачи команды. Обновите его или используйте существующую сессию."

msgid "This host did not provide a readable preview. Review the request in the agent CLI before approving."
msgstr "Этот хост не предоставил читаемый просмотр. Проверьте запрос в CLI агента перед одобрением."

msgid "This host does not support plain folders. Update the host and retry."
msgstr "Этот хост не поддерживает обычные папки. Обновите хост и повторите попытку."

msgid "This host does not support Teamwork. Update the host to use teams and mail."
msgstr "Этот хост не поддерживает Teamwork. Обновите хост для работы с командами и почтой."

msgid "This is a large file. Opening it may slow down the editor."
msgstr "Это большой файл. Его открытие может замедлить редактор."

msgid "This pane can't be shown"
msgstr "Эту панель нельзя показать"

