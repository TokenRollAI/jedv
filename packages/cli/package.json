{
	"name": "@jedv/cli",
	"version": "2.1.1",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "cli-framework dev",
		"build": "cli-framework build",
		"build:darwin-arm64": "cli-framework build --target=bun-darwin-arm64 --outfile=./dist/jedv-darwin-arm64",
		"build:linux-x64": "cli-framework build --target=bun-linux-x64 --outfile=./dist/jedv-linux-x64",
		"build:all": "bun run build:darwin-arm64 && bun run build:linux-x64",
		"prebuild:dist": "bun run --filter=@jedv/i18n build",
		"build:dist": "bun run scripts/build-dist.ts",
		"typecheck": "tsc --noEmit",
		"test": "bun test"
	},
	"dependencies": {
		"@clack/prompts": "0.10.1",
		"@jedv/agent-setup": "workspace:*",
		"@jedv/cli-framework": "workspace:*",
		"@jedv/host-service": "workspace:*",
		"@jedv/i18n": "workspace:*",
		"@jedv/local-db": "workspace:*",
		"@jedv/shared": "workspace:*",
		"@modelcontextprotocol/sdk": "1.32.0",
		"@trpc/client": "11.16.0",
		"date-fns": "4.1.0",
		"drizzle-orm": "0.45.2",
		"ink": "7.0.1",
		"mime-types": "3.0.2",
		"react": "19.3.0",
		"superjson": "2.2.6",
		"zod": "4.6.6"
	},
	"devDependencies": {
		"@jedv/typescript": "workspace:*",
		"@types/mime-types": "3.0.1",
		"@types/react": "19.3.0",
		"bun-types": "1.4.3",
		"typescript": "7.0.2"
	}
}
