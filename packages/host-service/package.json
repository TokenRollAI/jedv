{
	"name": "@jedv/host-service",
	"version": "2.1.2",
	"private": true,
	"type": "module",
	"exports": {
		"./teamwork": {
			"types": "./src/teams/types.ts"
		},
		".": {
			"types": "./src/index.ts",
			"default": "./src/index.ts"
		},
		"./acp-catalogue": {
			"types": "./src/chat-v3/acpCatalogue.ts",
			"default": "./src/chat-v3/acpCatalogue.ts"
		},
		"./db": {
			"types": "./src/db/index.ts",
			"default": "./src/db/index.ts"
		},
		"./daemon-manifest": {
			"types": "./src/daemon/manifest.ts",
			"default": "./src/daemon/manifest.ts"
		},
		"./daemon-probe": {
			"types": "./src/daemon/probe.ts",
			"default": "./src/daemon/probe.ts"
		},
		"./events": {
			"types": "./src/events/index.ts",
			"default": "./src/events/index.ts"
		},
		"./git": {
			"types": "./src/runtime/git/index.ts",
			"default": "./src/runtime/git/index.ts"
		},
		"./trpc": {
			"types": "./src/trpc/index.ts",
			"default": "./src/trpc/index.ts"
		},
		"./host-worker": {
			"types": "./src/workers/host-worker.ts",
			"default": "./src/workers/host-worker.ts"
		},
		"./git-credentials": {
			"types": "./src/providers/git/LocalGitCredentialProvider/index.ts",
			"default": "./src/providers/git/LocalGitCredentialProvider/index.ts"
		},
		"./terminal-env": {
			"types": "./src/terminal/env.ts",
			"default": "./src/terminal/env.ts"
		},
		"./settings": {
			"types": "./src/trpc/router/settings/index.ts",
			"default": "./src/trpc/router/settings/index.ts"
		},
		"./github-availability": {
			"types": "./src/runtime/pull-requests/utils/github-availability/index.ts",
			"default": "./src/runtime/pull-requests/utils/github-availability/index.ts"
		},
		"./attachments": {
			"types": "./src/trpc/router/attachments/index.ts",
			"default": "./src/trpc/router/attachments/index.ts"
		},
		"./router": {
			"types": "./dist-types/trpc/router/router.d.ts"
		},
		"./package.json": "./package.json"
	},
	"scripts": {
		"clean": "git clean -xdf .cache .turbo dist node_modules",
		"dev": "bun run src/serve.ts",
		"build:host": "bun run build.ts",
		"build:types": "tsc -p tsconfig.types.json",
		"generate": "drizzle-kit generate",
		"test": "bun test --pass-with-no-tests --parallel=4",
		"test:integration": "bun test --pass-with-no-tests test/integration",
		"test:integration:daemon": "node ../../scripts/test-node-isolated.mjs --experimental-strip-types --test src/terminal/DaemonClient/DaemonClient.node-test.ts src/daemon/DaemonSupervisor.node-test.ts",
		"test:node": "node ../../scripts/test-node-isolated.mjs",
		"test:integration:terminal": "node ../../scripts/test-node-isolated.mjs --import tsx --test src/terminal/terminal.initial-command.node-test.ts src/terminal/terminal.ungated-launch.node-test.ts src/terminal/terminal.shell-ready-learning.node-test.ts src/terminal/terminal.fish-prompt-transport.node-test.ts src/terminal/terminal.send-snapshot.node-test.ts src/trpc/router/usage/history/usage-sqlite.node-test.ts src/trpc/router/workspace-creation/shared/workspace-setup.node-test.ts",
		"test:integration:ports": "node --experimental-strip-types --test src/ports/forward-mux-route.node-test.ts",
		"test:integration:workers": "node --experimental-strip-types --test src/workers/worker-termination.node-test.ts",
		"test:e2e": "node ../../scripts/test-node-isolated.mjs --import tsx --test --test-force-exit --test-reporter=spec src/terminal/terminal.adoption.node-test.ts src/terminal/terminal.seq-catchup.node-test.ts",
		"bench": "bun test ./test/integration/pull-requests-scaling.bench.ts",
		"profile:git-status": "bun run scripts/git-status-large-repo-profile.ts",
		"typecheck": "tsc --noEmit --emitDeclarationOnly false"
	},
	"dependencies": {
		"@agentclientprotocol/claude-agent-acp": "0.85.0",
		"@agentclientprotocol/codex-acp": "2.1.0",
		"@hono/node-server": "2.0.10",
		"@hono/node-ws": "1.3.0",
		"@hono/trpc-server": "0.3.4",
		"@jedv/agent-setup": "workspace:*",
		"@jedv/chat": "workspace:*",
		"@jedv/chat-runtime": "workspace:*",
		"@jedv/port-scanner": "workspace:*",
		"@jedv/pty-daemon": "workspace:*",
		"@jedv/shared": "workspace:*",
		"@jedv/workspace-fs": "workspace:*",
		"@lingui/core": "6.12.0",
		"@octokit/rest": "22.0.1",
		"@t3-oss/env-core": "0.13.11",
		"@trpc/client": "11.16.0",
		"@trpc/server": "11.16.0",
		"@xterm/headless": "6.1.0-beta.313",
		"better-sqlite3": "12.11.1",
		"drizzle-orm": "0.45.2",
		"entities": "7.0.1",
		"hono": "4.13.11",
		"mime-types": "3.0.2",
		"node-pty": "1.2.0-beta.14",
		"pi-acp": "0.0.34",
		"semver": "7.7.4",
		"simple-git": "4.0.2",
		"superjson": "2.2.6",
		"tree-kill": "1.2.2",
		"ws": "8.21.3",
		"zod": "4.6.6"
	},
	"devDependencies": {
		"@jedv/i18n": "workspace:*",
		"@jedv/typescript": "workspace:*",
		"@types/better-sqlite3": "7.6.13",
		"@types/mime-types": "3.0.1",
		"@types/node": "24.12.0",
		"@types/semver": "7.7.1",
		"@types/ws": "8.18.1",
		"bun-types": "1.4.3",
		"drizzle-kit": "0.31.8",
		"tsx": "4.21.0",
		"typescript": "7.0.2"
	}
}
